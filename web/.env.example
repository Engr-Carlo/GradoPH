# GradoPH Web Dashboard Environment Variables
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (KEEP SECRET - for server-side operations only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: OpenCV.js CDN URL (for client-side processing)
# NEXT_PUBLIC_OPENCV_URL=https://docs.opencv.org/4.8.0/opencv.js
